OPENAGENT_IDENTITY_ISSUER=http://127.0.0.1:6201/oidc
OPENAGENT_IDENTITY_JWKS_URL=http://host.docker.internal:6201/oidc/jwks
OPENAGENT_MAIL_AUDIENCE=https://mail.openagent.md
OPENAGENT_MAIL_DOMAIN=agents.openagent.md
LEGACY_AGENT_MAIL_DOMAINS=
OPENAGENT_REQUIRED_SCOPES=mail:read
CAST_MAILBOX_GATEWAY_TOKEN=replace-with-a-separate-long-cast-service-secret
CAST_DKIM_SELECTOR=cast1
MAIL_PUBLIC_DELIVERY_CONFIGURED=false
CAST_AGENT_MAIL_WEBHOOK_URL=http://cast:3000/webhooks/messaging/agent-mail
CAST_MAILBOX_WEBHOOK_SECRET=replace-with-a-separate-long-webhook-secret
MAIL_TELEMETRY_WEBHOOK_SECRET=replace-with-a-separate-long-telemetry-secret
MAIL_TELEMETRY_WEBHOOK_CONFIGURED=false
STALWART_ADMIN_USERNAME=admin
STALWART_ADMIN_PASSWORD=replace-with-a-long-random-secret
STALWART_SERVER_HOSTNAME=mail.openagent.md
STALWART_AUTO_BOOTSTRAP=true
STALWART_CONFIGURE_OPENAGENT_OIDC=true
STALWART_CONFIGURE_CAST_MAIL=true
